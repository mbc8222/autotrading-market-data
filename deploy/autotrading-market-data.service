# AutoTrading Market Data — systemd 유닛 템플릿
#
# 설치:
#   sudo cp deploy/autotrading-market-data.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/autotrading-market-data.service   # User= 를 실제 계정으로(whoami)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now autotrading-market-data
#
# 전제: WSL2 에서 systemd 활성화(/etc/wsl.conf 에 [boot] systemd=true), JDK=/usr/lib/jvm/jdk-21,
#       JAR=/opt/autotrading/market-data/market-data.jar, 시크릿=/etc/autotrading/market-data.env

[Unit]
Description=AutoTrading Market Data Collector
# 네트워크 준비 후 기동 (바이낸스 WS/REST 연결 필요)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 실제 실행 계정으로 교체 (학습 단계는 본인 계정, 이후 전용 서비스 계정 권장)
User=__USER__
WorkingDirectory=/opt/autotrading/market-data

# 운영 프로파일 — 기본값(local) 을 override. 접속정보/시크릿은 아래 EnvironmentFile 로 주입.
Environment=SPRING_PROFILES_ACTIVE=prod
EnvironmentFile=/etc/autotrading/market-data.env

# java 절대경로 — PATH/alternatives 에 의존하지 않음
ExecStart=/usr/lib/jvm/jdk-21/bin/java -jar /opt/autotrading/market-data/market-data.jar

# Spring Boot 가 SIGTERM 받고 정상 종료하면 143(128+15) 로 끝남 — 실패로 보지 않음
SuccessExitStatus=143

# ★ 무중단 핵심: 죽으면 5초 뒤 자동 재시작 (25h 손실 재발 방지)
Restart=always
RestartSec=5

[Install]
# ★ 부팅 시 자동 기동 (enable 했을 때)
WantedBy=multi-user.target
