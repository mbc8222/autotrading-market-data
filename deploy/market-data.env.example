# market-data.env.example — 운영 접속정보/시크릿 템플릿 (Docker compose env_file)
#
# 사용:
#   cp deploy/market-data.env.example deploy/market-data.env
#   nano deploy/market-data.env      # 실제 값 채우기 (DB 계정/비번 등)
#   # docker-compose.yml 의 env_file 이 이 파일을 읽어 컨테이너 환경변수로 주입한다.
#
# Spring relaxed binding 으로 환경변수가 프로퍼티에 매핑된다:
#   SPRING_DATASOURCE_PASSWORD -> spring.datasource.password
#   SPRING_FLYWAY_DEFAULT_SCHEMA -> spring.flyway.default-schema
#
# 이 .example 만 git 추적. 실제 deploy/market-data.env 는 .gitignore(*.env)로 제외 — 절대 커밋 금지.
# (KEY=VALUE 한 줄 형식. 따옴표 불필요, 값 안의 = 와 ? 는 그대로 둔다.)
#
# ★ 컨테이너→호스트 접속: PostgreSQL01·redis 는 이 compose 밖의 별도 컨테이너이고 호스트로
#   포트를 발행하므로 host.docker.internal 로 닿는다(localhost 아님 — 컨테이너 내부 localhost 는 자기 자신).

# PostgreSQL (별도 컨테이너 PostgreSQL01, 호스트 5432 발행)
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/marketdata?currentSchema=marketdata
SPRING_DATASOURCE_USERNAME=changeme
SPRING_DATASOURCE_PASSWORD=changeme

# Flyway — 위 DataSource 공유, 스키마만 지정
SPRING_FLYWAY_DEFAULT_SCHEMA=marketdata
SPRING_FLYWAY_SCHEMAS=marketdata

# Redis (별도 컨테이너 redis, 호스트 6379 발행)
SPRING_DATA_REDIS_HOST=host.docker.internal
SPRING_DATA_REDIS_PORT=6379
