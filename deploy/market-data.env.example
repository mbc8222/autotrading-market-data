# market-data.env.example — 운영(prod) 접속정보 템플릿 (Docker compose env_file)
#
# 사용:
#   cp deploy/market-data.env.example deploy/market-data.env
#   # deploy/market-data.env 에 실제 값(DB 계정/비번 등)을 채운다
#   docker compose up -d --build
#
# Spring relaxed binding 으로 환경변수가 프로퍼티에 매핑된다:
#   SPRING_DATASOURCE_PASSWORD    -> spring.datasource.password
#   SPRING_FLYWAY_DEFAULT_SCHEMA  -> spring.flyway.default-schema
#
# 이 .example 만 git 추적. 실제 deploy/market-data.env 는 .gitignore(*.env)로 제외 — 절대 커밋 금지.
# (KEY=VALUE 한 줄 형식. 따옴표 불필요, 값 안의 = 와 ? 는 그대로 둔다.)
#
# ★ 컨테이너→인프라 접속은 공유 외부망 `autotrading-net` 의 컨테이너명으로 직결한다(2026-06-14).
#   host.docker.internal 우회는 간헐 연결 드롭의 원인이라 쓰지 않는다(compose 의 extra_hosts 는 폴백일 뿐).
#   따라서 PostgreSQL·Redis 컨테이너가 이 망에 합류해 있어야 하고, 아래 host 는 그 컨테이너 이름이다.
#     docker network create autotrading-net
#     docker network connect autotrading-net <postgres 컨테이너>
#     docker network connect autotrading-net <redis 컨테이너>

# PostgreSQL — host 는 공유망에서의 컨테이너 이름(별칭)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/marketdata?currentSchema=marketdata
SPRING_DATASOURCE_USERNAME=changeme
SPRING_DATASOURCE_PASSWORD=changeme

# Flyway — 위 DataSource 공유, 스키마만 지정
SPRING_FLYWAY_DEFAULT_SCHEMA=marketdata
SPRING_FLYWAY_SCHEMAS=marketdata

# Redis — host 는 공유망에서의 컨테이너 이름(별칭)
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
