# market-data.env.example — systemd EnvironmentFile 템플릿 (운영 접속정보/시크릿)
#
# 운영(WSL) 배포 절차:
#   sudo mkdir -p /etc/autotrading
#   sudo cp deploy/market-data.env.example /etc/autotrading/market-data.env
#   sudo nano /etc/autotrading/market-data.env      # 실제 값 채우기
#   sudo chown <서비스계정> /etc/autotrading/market-data.env
#   sudo chmod 600 /etc/autotrading/market-data.env  # 소유자만 읽기
#
# Spring relaxed binding 으로 환경변수가 프로퍼티에 매핑된다:
#   SPRING_DATASOURCE_PASSWORD -> spring.datasource.password
#   SPRING_FLYWAY_DEFAULT_SCHEMA -> spring.flyway.default-schema
#
# 이 .example 만 git 추적. 실제 *.env 는 .gitignore 로 제외 — 절대 커밋 금지.
# (systemd EnvironmentFile 은 KEY=VALUE 한 줄 형식. 따옴표 불필요, 값 안의 = 와 ? 는 그대로 둔다.)

# PostgreSQL (Docker 컨테이너 PostgreSQL01)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marketdata?currentSchema=marketdata
SPRING_DATASOURCE_USERNAME=changeme
SPRING_DATASOURCE_PASSWORD=changeme

# Flyway — 위 DataSource 공유, 스키마만 지정
SPRING_FLYWAY_DEFAULT_SCHEMA=marketdata
SPRING_FLYWAY_SCHEMAS=marketdata

# Redis (Docker 컨테이너 redis)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
